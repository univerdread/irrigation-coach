{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:irrigation-coach:farm-input",
  "title": "Engine input: one farm, one pump, one or more plots, one day",
  "type": "object",
  "required": [
    "today",
    "pump",
    "plots"
  ],
  "properties": {
    "today": {
      "$ref": "urn:irrigation-coach:common#/$defs/date"
    },
    "pump": {
      "type": "object",
      "required": [
        "flow"
      ],
      "properties": {
        "flow": {
          "oneOf": [
            {
              "$ref": "urn:irrigation-coach:common#/$defs/flow_input"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "cap_litres": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Daily water cap shared by all plots. null/absent = no cap."
    },
    "priority": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fill order under a cap. A demo order, not agronomic advice. Default: plot order."
    },
    "rain_model": {
      "$ref": "#/$defs/rain_model"
    },
    "plots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plot"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rain_model": {
      "description": "Effective-rain step. Placeholder defaults until validated locally. Result is always capped at the current deficit.",
      "type": "object",
      "required": [
        "fraction",
        "ignore_below_mm"
      ],
      "properties": {
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ignore_below_mm": {
          "type": "number",
          "minimum": 0
        },
        "provenance": {
          "$ref": "urn:irrigation-coach:common#/$defs/provenance"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "plot": {
      "type": "object",
      "required": [
        "id",
        "area_m2",
        "efficiency",
        "crop",
        "soil_awc_mm_per_m",
        "deficit",
        "rain_since_mm"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "area_m2": {
          "oneOf": [
            {
              "$ref": "urn:irrigation-coach:common#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "$ref": "urn:irrigation-coach:common#/$defs/method_id"
        },
        "efficiency": {
          "oneOf": [
            {
              "$ref": "urn:irrigation-coach:common#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "crop": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "crop_id",
                "stage",
                "provenance"
              ],
              "properties": {
                "crop_id": {
                  "type": "string"
                },
                "stage": {
                  "oneOf": [
                    {
                      "$ref": "urn:irrigation-coach:common#/$defs/crop_stage"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "planting_date": {
                  "$ref": "urn:irrigation-coach:common#/$defs/date"
                },
                "provenance": {
                  "$ref": "urn:irrigation-coach:common#/$defs/provenance"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "root_depth_m": {
          "$ref": "urn:irrigation-coach:common#/$defs/quantity",
          "description": "Override of the crop-table root depth."
        },
        "p": {
          "$ref": "urn:irrigation-coach:common#/$defs/quantity",
          "description": "Override of the crop-table depletion fraction."
        },
        "soil_awc_mm_per_m": {
          "oneOf": [
            {
              "$ref": "urn:irrigation-coach:common#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "deficit": {
          "description": "Last known root-zone depletion (mm below field capacity) and the date it refers to.",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "mm",
                "as_of",
                "provenance"
              ],
              "properties": {
                "mm": {
                  "type": "number",
                  "minimum": 0
                },
                "as_of": {
                  "$ref": "urn:irrigation-coach:common#/$defs/datetime"
                },
                "provenance": {
                  "$ref": "urn:irrigation-coach:common#/$defs/provenance"
                },
                "source": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "rain_since_mm": {
          "description": "Rain reported since deficit.as_of, in mm as read from a straight-sided container. null = unknown (never zero).",
          "oneOf": [
            {
              "$ref": "urn:irrigation-coach:common#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "moisture_check": {
          "type": "object",
          "required": [
            "band",
            "observed_at",
            "provenance",
            "source"
          ],
          "properties": {
            "band": {
              "$ref": "urn:irrigation-coach:common#/$defs/moisture_band"
            },
            "observed_at": {
              "$ref": "urn:irrigation-coach:common#/$defs/datetime"
            },
            "provenance": {
              "$ref": "urn:irrigation-coach:common#/$defs/provenance"
            },
            "source": {
              "enum": [
                "photo_model",
                "feel_chart",
                "sensor"
              ]
            },
            "mocked": {
              "type": "boolean",
              "description": "true if the photo result did not come from a live model"
            }
          },
          "additionalProperties": false
        },
        "consecutive_disagreements": {
          "type": "integer",
          "minimum": 0,
          "description": "Earlier soil checks in a row that disagreed with the engine, not counting moisture_check. >= 1 plus a disagreeing check escalates to the extension officer."
        },
        "assume_due": {
          "type": "boolean",
          "description": "FIXTURE ONLY. Bypasses the trigger; recorded in the plan's assumptions."
        },
        "context": {
          "type": "object",
          "properties": {
            "slope_pct": {
              "type": "number"
            },
            "clay_pct": {
              "type": "number"
            },
            "salty_water_reported": {
              "type": "boolean"
            },
            "fertilizer_applied_on": {
              "$ref": "urn:irrigation-coach:common#/$defs/date"
            },
            "water_scarce": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "location": {
          "type": "object",
          "required": [
            "lat",
            "lon"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "additionalProperties": false,
          "description": "Plot centre from the GPS walk. Used for soil-map and climatology lookup. Personal data: stays on the phone unless the farmer shares it."
        }
      },
      "additionalProperties": false
    }
  }
}
