{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:irrigation-coach:common",
  "title": "Shared definitions",
  "$defs": {
    "provenance": {
      "description": "Where a value came from. measured = instrument/procedure on this plot (bucket test, weighed sample); reported = farmer said so (rain gauge reading, 'done' tap); mapped = read from the area pack (iSDAsoil, climatology); estimated = computed by the engine from other inputs; simulated = demo fixture, never real; table = published parameter (FAO-56 etc.); assumed = team/demo assumption awaiting validation. The UI must render these visibly differently.",
      "enum": ["measured", "reported", "mapped", "estimated", "simulated", "table", "assumed"]
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "datetime": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[0-9:.]+(Z|[+-]\\d{2}:\\d{2})?)?$" },
    "quantity": {
      "description": "A number with unit and provenance. value null = unknown (never treat as zero).",
      "type": "object",
      "required": ["value", "unit", "provenance"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "source": { "type": "string" },
        "observed_at": { "$ref": "#/$defs/datetime" }
      },
      "additionalProperties": false
    },
    "flow_input": {
      "description": "Pump flow as entered. The engine normalises to L/min at the boundary.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value", "unit", "provenance"],
          "properties": {
            "kind": { "const": "rate" },
            "value": { "type": ["number", "null"] },
            "unit": { "enum": ["L/min", "L/h", "m3/h"] },
            "provenance": { "$ref": "#/$defs/provenance" },
            "source": { "type": "string" },
            "observed_at": { "$ref": "#/$defs/datetime" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "litres", "seconds", "provenance"],
          "properties": {
            "kind": { "const": "bucket" },
            "litres": { "type": "number", "exclusiveMinimum": 0 },
            "seconds": { "type": "number", "exclusiveMinimum": 0 },
            "provenance": { "$ref": "#/$defs/provenance" },
            "source": { "type": "string" },
            "observed_at": { "$ref": "#/$defs/datetime" }
          },
          "additionalProperties": false
        }
      ]
    },
    "crop_stage": { "enum": ["ini", "dev", "mid", "late"] },
    "method_id": { "enum": ["furrow", "sprinkler", "drip"] },
    "moisture_band": {
      "description": "Feel/photo moisture class. dry = needs water soon; ok = some water used; wet = near field capacity.",
      "enum": ["dry", "ok", "wet"]
    },
    "essential_input": {
      "enum": ["area", "flow", "efficiency", "crop_stage", "soil_awc", "deficit", "rain_since"]
    },
    "question_key": {
      "enum": ["ask_area", "ask_bucket_test", "ask_method", "ask_crop_stage", "ask_soil_test", "ask_moisture_check", "ask_rain_since", "ask_second_check", "escalate_extension_officer"]
    }
  }
}
